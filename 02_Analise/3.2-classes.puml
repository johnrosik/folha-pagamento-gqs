@startuml
skinparam classAttributeIconSize 0

abstract class Colaborador {
    + matricula: str
    + nome: str
    + {abstract} calcular_salario_bruto(): float
    + calcular_inss(): float
    + calcular_irrf(): float
    + calcular_salario_liquido(): float
}

class ColaboradorPadrao {
    + salario_base: float
    + calcular_salario_bruto(): float
}

class ColaboradorComissionado {
    + salario_base: float
    + vendas: float
    + comissao_pct: float
    + calcular_salario_bruto(): float
}
note bottom of ColaboradorComissionado
  bruto = salario_base + vendas × comissao_pct ÷ 100
end note

class ColaboradorProducao {
    + salario_base: float
    + qtd_produzida: int
    + valor_unidade: float
    + calcular_salario_bruto(): float
}
note bottom of ColaboradorProducao
  bruto = salario_base + qtd_produzida × valor_unidade
end note

class SistemaFolha {
    + cadastrar(c: Colaborador)
    + consultar(matricula: str): Colaborador
    + listar(): list
    + alterar(matricula: str, dados: dict)
    + excluir(matricula: str)
    + gerar_folha_individual(matricula: str): dict
    + emitir_resumo_folha(): dict
}

class RepositorioSQLite {
    + caminho_banco: str
    + inserir(c: Colaborador)
    + buscar(matricula: str): Colaborador
    + listar(): list
    + atualizar(c: Colaborador)
    + remover(matricula: str)
}

class ValidacaoError

Colaborador <|-- ColaboradorPadrao
Colaborador <|-- ColaboradorComissionado
Colaborador <|-- ColaboradorProducao
SistemaFolha --> RepositorioSQLite : usa
SistemaFolha ..> Colaborador : gerencia
RepositorioSQLite ..> Colaborador : grava e restaura
Colaborador ..> ValidacaoError : lança (RN002 a RN007)
@enduml
